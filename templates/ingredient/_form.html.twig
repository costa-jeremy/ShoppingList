{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_row(form.name) }}
            <div id="duplicate-warning" class="alert alert-warning py-2 mt-2 d-none" role="status"></div>
        </div>
        <div class="col-12">
            {{ form_row(form.unit) }}
        </div>
        <div class="col-12">
            <div class="d-grid">
                <button type="submit" class="btn {{ button_class|default('btn-primary') }} btn-lg">
                    <i class="fas fa-save me-1"></i>
                    {{ button_label|default('Enregistrer') }}
                </button>
            </div>
        </div>
    </div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const nameInput = document.getElementById('{{ form.name.vars.id }}');
        const unitSelect = document.getElementById('{{ form.unit.vars.id }}');
        const warning = document.getElementById('duplicate-warning');
        const checkUrl = '{{ path('app_ingredient_check_duplicate') }}';
        const excludeId = '{{ form.vars.value.id ?? '' }}';
        let homonyms = [];
        let debounceTimer;

        // Doublon = même nom ET même unité (bloquant) ; même nom dans une autre unité = variante autorisée
        function render() {
            const unit = unitSelect.value;
            const label = d => `« ${d.name} » (${d.unit})`;
            const sameUnit = homonyms.filter(d => d.unit === unit);
            const otherUnits = homonyms.filter(d => d.unit !== unit);

            warning.classList.remove('alert-warning', 'alert-info');
            if (sameUnit.length > 0) {
                warning.textContent = `⚠️ Cet ingrédient existe déjà dans cette unité : ${sameUnit.map(label).join(', ')}. Choisissez une autre unité pour créer une variante.`;
                warning.classList.add('alert-warning');
            } else if (otherUnits.length > 0) {
                warning.textContent = `ℹ️ Vous avez déjà ${otherUnits.map(label).join(', ')}.` + (unit ? ' Une variante dans cette unité sera créée.' : ' Choisissez une autre unité pour créer une variante.');
                warning.classList.add('alert-info');
            }
            warning.classList.toggle('d-none', homonyms.length === 0);
        }

        nameInput.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const name = this.value.trim();
            if (name === '') {
                homonyms = [];
                render();
                return;
            }

            // Vérification côté serveur 300ms après la dernière saisie
            debounceTimer = setTimeout(() => {
                const params = new URLSearchParams({ name: name, exclude: excludeId });
                fetch(`${checkUrl}?${params}`)
                    .then(response => response.json())
                    .then(data => {
                        homonyms = data;
                        render();
                    })
                    .catch(err => console.error('Erreur vérification doublon:', err));
            }, 300);
        });

        unitSelect.addEventListener('change', render);
    });
</script>
