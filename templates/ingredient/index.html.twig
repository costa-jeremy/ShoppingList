{% extends 'base.html.twig' %}

{% block title %}Mes ingrédients{% endblock %}

{% block breadcrumb %}
    <nav style="--bs-breadcrumb-divider:'>';font-size:14px">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    <i class="fa-solid fa-house"></i>
                </a>
            </li>
            <li class="breadcrumb-item active">Mes ingrédients</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="page-header">
            <div>
                <h1>Mes ingrédients</h1>
                <p class="page-subtitle">{{ ingredients|length }} ingrédient{{ ingredients|length > 1 ? 's' }}{{ search ? ' trouvé' ~ (ingredients|length > 1 ? 's') }}</p>
            </div>
            <a href="{{ path('app_ingredient_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Nouvel ingrédient
            </a>
        </div>

        <form method="get" action="{{ path('app_ingredient_index') }}" class="d-flex gap-2 mb-3" role="search">
            <div class="search-bar flex-fill" style="max-width: 32rem">
                <i class="fas fa-search"></i>
                <input type="search" name="q" value="{{ search }}" class="form-control"
                       placeholder="Rechercher un ingrédient..." aria-label="Rechercher un ingrédient">
            </div>
            {% if search %}
                <a href="{{ path('app_ingredient_index') }}" class="btn btn-secondary rounded-pill" title="Effacer la recherche">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </form>

        {% if duplicate_ids is not empty %}
            <div class="alert alert-warning">
                <i class="fas fa-clone me-2"></i>
                Certains ingrédients sont en double (même nom et même unité, badge « Doublon »). Vous pouvez les fusionner en les modifiant ou en supprimant l'un d'eux.
            </div>
        {% endif %}

        <div class="card item-list">
            {% for ingredient in ingredients %}
                <div class="item-row">
                    <span class="item-avatar avatar-sky">{{ ingredient.name|first }}</span>
                    <div class="item-main">
                        <a href="{{ path('app_ingredient_edit', {'id': ingredient.id}) }}" class="item-title stretched-link">
                            {{ ingredient.name }}
                        </a>
                        {% if ingredient.id in duplicate_ids %}
                            <span class="badge bg-warning text-dark" title="Un autre ingrédient a le même nom et la même unité">Doublon</span>
                        {% endif %}
                    </div>
                    <span class="unit-pill">{{ ingredient.unit }}</span>
                    <div class="item-actions">
                        <a href="{{ path('app_ingredient_edit', {'id': ingredient.id}) }}"
                           class="btn btn-action" title="Modifier l'ingrédient" aria-label="Modifier {{ ingredient.name }}">
                            <i class="fas fa-pen"></i>
                        </a>
                        <form method="post"
                              action="{{ path('app_ingredient_delete', {'id': ingredient.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet ingrédient ? Attention, il sera supprimé de toutes les recettes qui l\'utilisent !');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ingredient.id) }}">
                            <button type="submit" class="btn btn-action btn-action-danger" title="Supprimer l'ingrédient" aria-label="Supprimer {{ ingredient.name }}">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-carrot"></i></div>
                    {% if search %}
                        <p class="mb-0">Aucun ingrédient ne correspond à « {{ search }} »</p>
                    {% else %}
                        <p>Aucun ingrédient pour le moment</p>
                        <a href="{{ path('app_ingredient_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Ajouter mon premier ingrédient
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
