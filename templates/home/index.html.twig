{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    {% set hour = 'now'|date('G') %}
    <div class="container-fluid py-4">
        <div class="hero-card mb-4">
            <span class="hero-mark">{{ include('_partials/logo_mark.html.twig') }}</span>
            <h1>{{ hour < 18 ? 'Bonjour' : 'Bonsoir' }} 👋</h1>
            <p>On cuisine quoi aujourd'hui ? Préparez votre prochaine liste de courses en quelques clics.</p>
            <a href="{{ path('app_shopping_list_new') }}" class="btn btn-light fw-bold mt-3 position-relative">
                <i class="fas fa-basket-shopping me-2 text-primary"></i>Nouvelle liste de courses
            </a>
        </div>

        <div class="row g-2 g-md-3 mb-4">
            <div class="col-4">
                <a href="{{ path('app_recipe_index') }}" class="stat-tile flex-column flex-md-row text-center text-md-start">
                    <span class="item-avatar"><i class="fas fa-book-open"></i></span>
                    <span>
                        <span class="stat-value d-block">{{ counts.recipes }}</span>
                        <span class="stat-label">recette{{ counts.recipes > 1 ? 's' }}</span>
                    </span>
                </a>
            </div>
            <div class="col-4">
                <a href="{{ path('app_shopping_list_index') }}" class="stat-tile flex-column flex-md-row text-center text-md-start">
                    <span class="item-avatar avatar-tomato"><i class="fas fa-basket-shopping"></i></span>
                    <span>
                        <span class="stat-value d-block">{{ counts.shoppingLists }}</span>
                        <span class="stat-label">liste{{ counts.shoppingLists > 1 ? 's' }}</span>
                    </span>
                </a>
            </div>
            <div class="col-4">
                <a href="{{ path('app_ingredient_index') }}" class="stat-tile flex-column flex-md-row text-center text-md-start">
                    <span class="item-avatar avatar-sky"><i class="fas fa-carrot"></i></span>
                    <span>
                        <span class="stat-value d-block">{{ counts.ingredients }}</span>
                        <span class="stat-label">ingrédient{{ counts.ingredients > 1 ? 's' }}</span>
                    </span>
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="section-title">
                    <h2>Dernières listes</h2>
                    <a href="{{ path('app_shopping_list_index') }}">Tout voir <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
                <div class="card item-list">
                    {% for shoppingList in recentShoppingLists %}
                        <div class="item-row">
                            <span class="item-avatar avatar-tomato"><i class="fas fa-list-check"></i></span>
                            <div class="item-main">
                                <a href="{{ path('app_shopping_list_show', {'id': shoppingList.id}) }}" class="item-title stretched-link">
                                    {{ shoppingList.name ?: 'Liste sans nom' }}
                                </a>
                                <div class="item-meta">
                                    <span><i class="far fa-calendar me-1"></i>{{ shoppingList.createdAt|date('d/m/Y') }}</span>
                                    <span>{{ shoppingList.recipes|length }} recette{{ shoppingList.recipes|length > 1 ? 's' }}</span>
                                </div>
                            </div>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-basket-shopping"></i></div>
                            <p>Aucune liste de courses pour le moment</p>
                            <a href="{{ path('app_shopping_list_new') }}" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Créer une liste
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="section-title">
                    <h2>Dernières recettes</h2>
                    <a href="{{ path('app_recipe_index') }}">Tout voir <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
                <div class="card item-list">
                    {% for recipe in recentRecipes %}
                        <div class="item-row">
                            <span class="item-avatar">{{ recipe.name|first }}</span>
                            <div class="item-main">
                                <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="item-title stretched-link">
                                    {{ recipe.name }}
                                </a>
                                <div class="item-meta">
                                    <span>{{ recipe.recipeIngredients|length }} ingrédient{{ recipe.recipeIngredients|length > 1 ? 's' }}</span>
                                    {% if recipe.numberOfTimes > 0 %}
                                        <span><i class="fas fa-fire-burner me-1"></i>préparée {{ recipe.numberOfTimes }} fois</span>
                                    {% endif %}
                                </div>
                            </div>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-icon"><i class="fas fa-book-open"></i></div>
                            <p>Aucune recette pour le moment</p>
                            <a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Créer une recette
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="section-title mt-4">
            <h2>Accès rapides</h2>
        </div>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <a href="{{ path('app_shopping_list_new') }}" class="quick-action"><i class="fas fa-basket-shopping"></i>Nouvelle liste de courses</a>
            </div>
            <div class="col-12 col-md-4">
                <a href="{{ path('app_recipe_new') }}" class="quick-action"><i class="fas fa-book-open"></i>Nouvelle recette</a>
            </div>
            <div class="col-12 col-md-4">
                <a href="{{ path('app_ingredient_new') }}" class="quick-action"><i class="fas fa-carrot"></i>Nouvel ingrédient</a>
            </div>
        </div>
    </div>
{% endblock %}
