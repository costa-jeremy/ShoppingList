<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{% block title %}CuisiNotes{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="manifest" href="{{ asset('manifest.json') }}?v=3">
    <meta name="theme-color" content="#f7f4ee">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('app-icons/apple-touch-icon.png') }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Cuisinotes">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
        {{ encore_entry_link_tags('app') }}

        <link rel="stylesheet" href=
        "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
              integrity=
              "sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
              crossorigin="anonymous"
              referrerpolicy="no-referrer" />
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>

{% set current_route = app.request.attributes.get('_route') ?? '' %}
{% set flash_messages %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {% if label == 'success' %}
                    <i class="fas fa-check-circle me-2"></i>
                {% elseif label == 'error' or label == 'danger' %}
                    <i class="fas fa-exclamation-triangle me-2"></i>
                {% elseif label == 'warning' %}
                    <i class="fas fa-exclamation-circle me-2"></i>
                {% else %}
                    <i class="fas fa-info-circle me-2"></i>
                {% endif %}
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}
{% endset %}

{% if app.user %}
{% set nav_items = [
    {route: 'app_home', prefix: 'app_home', icon: 'fa-house', label: 'Tableau de bord', short: 'Accueil'},
    {route: 'app_recipe_index', prefix: 'app_recipe', icon: 'fa-book-open', label: 'Mes recettes', short: 'Recettes'},
    {route: 'app_shopping_list_index', prefix: 'app_shopping_list', icon: 'fa-basket-shopping', label: 'Mes listes de courses', short: 'Listes'},
    {route: 'app_ingredient_index', prefix: 'app_ingredient', icon: 'fa-carrot', label: 'Mes ingrédients', short: 'Ingrédients'},
] %}
<div class="app-shell">
    <aside id="bdSidebar" class="app-sidebar offcanvas-md offcanvas-start" tabindex="-1" aria-label="Menu principal">
        <div class="d-flex justify-content-between align-items-center">
            {{ include('_partials/brand.html.twig') }}
            <button type="button" class="btn-close d-md-none"
                    data-bs-dismiss="offcanvas" data-bs-target="#bdSidebar" aria-label="Fermer le menu"></button>
        </div>

        <ul class="app-nav">
            {% for item in nav_items %}
                <li>
                    <a href="{{ path(item.route) }}" class="{{ current_route starts with item.prefix ? 'active' }}"
                       {% if current_route starts with item.prefix %}aria-current="page"{% endif %}>
                        <i class="fa-solid {{ item.icon }}"></i>
                        {{ item.label }}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <div class="nav-section-label">Aide</div>
        <ul class="app-nav mt-0">
            <li>
                <a href="{{ path('app_how_it_works') }}" class="{{ current_route starts with 'app_how_it_works' ? 'active' }}">
                    <i class="fa-solid fa-circle-question"></i>
                    Comment ça marche ?
                </a>
            </li>
        </ul>

        <div class="mt-auto pt-4">
            <div class="sidebar-user">
                <span class="avatar">{{ app.user.email|first }}</span>
                <a href="{{ path('app_account_settings') }}" class="email text-truncate flex-fill" title="Mon compte">
                    {{ app.user.email }}
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-action btn-action-danger" title="Déconnexion" aria-label="Déconnexion">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <div class="flex-fill main-column">
        <header class="app-topbar d-md-none">
            {{ include('_partials/brand.html.twig') }}
        </header>

        <main class="main-content">
            <div class="breadcrumb-nav d-none d-md-block">
                {% block breadcrumb %}{% endblock %}
            </div>

            {{ flash_messages }}

            {% block body %}{% endblock %}
        </main>
    </div>

    <nav class="app-tabbar d-md-none" aria-label="Navigation principale">
        {% for item in nav_items %}
            <a href="{{ path(item.route) }}" class="{{ current_route starts with item.prefix ? 'active' }}"
               {% if current_route starts with item.prefix %}aria-current="page"{% endif %}>
                <i class="fa-solid {{ item.icon }}"></i>
                {{ item.short }}
            </a>
        {% endfor %}
        <a href="#bdSidebar" role="button" data-bs-toggle="offcanvas" aria-controls="bdSidebar"
           class="{{ current_route starts with 'app_account' or current_route starts with 'app_how_it_works' ? 'active' }}">
            <i class="fa-solid fa-ellipsis"></i>
            Plus
        </a>
    </nav>
</div>
{% else %}
<div class="auth-wrapper">
    {{ include('_partials/brand.html.twig', {size: 'brand-lg'}) }}
    <p class="auth-tagline">Vos recettes, vos ingrédients et vos listes de courses, au même endroit.</p>
    <div class="auth-card">
        {{ flash_messages }}
        {{ block('body') }}
    </div>
</div>
{% endif %}

<script>
    // Enregistrement du Service Worker pour PWA (uniquement en production)
    // Désactivé en développement pour éviter les erreurs SSL
    if ('serviceWorker' in navigator &&
        location.protocol === 'https:' &&
        !location.hostname.includes('.dev.') &&
        !location.hostname.includes('localhost')) {
        window.addEventListener('load', function() {
            navigator.serviceWorker.register('/service-worker.js')
                .then(function(registration) {
                    console.log('Service Worker enregistré avec succès:', registration.scope);
                })
                .catch(function(error) {
                    console.log('Erreur lors de l\'enregistrement du Service Worker:', error);
                });
        });
    }
</script>

</body>
</html>
