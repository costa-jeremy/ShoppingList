<!DOCTYPE html>
<html lang="FR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CuisiNotes{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <meta name="theme-color" content="#198754">
    <link rel="apple-touch-icon" href="{{ asset('favicon-192.png') }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CuisiNotes">
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}


        <link rel="stylesheet" href=
        "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
              integrity=
              "sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
              crossorigin="anonymous"
              referrerpolicy="no-referrer" />
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>

{% set current_route = app.request.attributes.get('_route') ?? '' %}
<div class="container-fluid p-0 d-flex min-vh-100">
    {% if app.user %}
    <div id="bdSidebar"
         class="d-flex flex-column
                    flex-shrink-0
                    p-3 bg-success
                    text-white offcanvas-md offcanvas-start"
         tabindex="-1" aria-label="Menu principal">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">
                <a href="{{ path('app_home') }}" class="text-white text-decoration-none">
                    <i class="fa-solid fa-utensils me-2"></i>
                    Cuisinotes
                </a>
            </h4>
            <button type="button" class="btn-close btn-close-white d-md-none"
                    data-bs-dismiss="offcanvas" data-bs-target="#bdSidebar" aria-label="Fermer le menu"></button>
        </div>
        <hr>
        <ul class="mynav nav nav-pills flex-column mb-auto">
            <li class="nav-item mb-1">
                <a href="{{ path('app_recipe_index') }}" class="{{ current_route starts with 'app_recipe' ? 'active' }}">
                    <i class="fa-regular fa-bookmark"></i>
                    Mes recettes
                </a>
            </li>
            <li class="nav-item mb-1">
                <a href="{{ path('app_ingredient_index') }}" class="{{ current_route starts with 'app_ingredient' ? 'active' }}">
                    <i class="fa-solid fa-pepper-hot"></i>
                    Mes ingrédients
                </a>
            </li>
            <li class="nav-item mb-1">
                <a href="{{ path('app_shopping_list_index') }}" class="{{ current_route starts with 'app_shopping_list' ? 'active' }}">
                    <i class="fa-regular fa-newspaper"></i>
                    Mes listes de course
                </a>
            </li>
            <li class="nav-item mb-1">
                <a href="{{ path('app_how_it_works') }}" class="{{ current_route starts with 'app_how_it_works' ? 'active' }}">
                    <i class="fa-solid fa-circle-info"></i>
                    Comment ça marche ?
                </a>
            </li>
        </ul>
        <hr>
        <div class="d-flex flex-column">
            <a href="{{ path('app_account_settings') }}" class="text-white text-decoration-none mb-2 hover-opacity">
                <i class="fa-solid fa-user me-2"></i>
                <span>{{ app.user.email }}</span>
            </a>
            <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-right-from-bracket me-2"></i>
                Déconnexion
            </a>
        </div>
    </div>
    {% endif %}

    <div class="bg-light flex-fill main-column">
        {% if app.user %}
        <div class="mobile-topbar d-md-none d-flex align-items-center text-white bg-success">
            <button type="button" class="menu-toggle btn text-white"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#bdSidebar"
                    aria-controls="bdSidebar"
                    aria-label="Ouvrir le menu">
                <i class="fa-solid fa-bars"></i>
            </button>
            <span class="mobile-topbar-title text-truncate">{{ block('title') }}</span>
            <a href="{{ path('app_home') }}" class="menu-toggle btn text-white ms-auto" aria-label="Tableau de bord">
                <i class="fa-solid fa-house"></i>
            </a>
        </div>
        {% endif %}
        <div class="main-content p-md-4">
            {% block breadcrumb %}
            <nav style="--bs-breadcrumb-divider:'>';font-size:14px">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <i class="fa-solid fa-house"></i>
                    </li>
                    <li class="breadcrumb-item">Accueil</li>
                </ol>
            </nav>
            {% endblock %}

            <hr>

            {# Messages flash #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {% if label == 'success' %}
                            <i class="fas fa-check-circle me-2"></i>
                        {% elseif label == 'error' or label == 'danger' %}
                            <i class="fas fa-exclamation-triangle me-2"></i>
                        {% elseif label == 'warning' %}
                            <i class="fas fa-exclamation-circle me-2"></i>
                        {% else %}
                            <i class="fas fa-info-circle me-2"></i>
                        {% endif %}
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

    </div>
</div>

<script>
    // Enregistrement du Service Worker pour PWA (uniquement en production)
    // Désactivé en développement pour éviter les erreurs SSL
    if ('serviceWorker' in navigator &&
        location.protocol === 'https:' &&
        !location.hostname.includes('.dev.') &&
        !location.hostname.includes('localhost')) {
        window.addEventListener('load', function() {
            navigator.serviceWorker.register('/service-worker.js')
                .then(function(registration) {
                    console.log('Service Worker enregistré avec succès:', registration.scope);
                })
                .catch(function(error) {
                    console.log('Erreur lors de l\'enregistrement du Service Worker:', error);
                });
        });
    }
</script>

</body>
</html>
