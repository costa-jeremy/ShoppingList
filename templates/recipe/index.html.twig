{% extends 'base.html.twig' %}

{% block title %}Mes recettes{% endblock %}

{% block breadcrumb %}
    <nav style="--bs-breadcrumb-divider:'>';font-size:14px">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    <i class="fa-solid fa-house"></i>
                </a>
            </li>
            <li class="breadcrumb-item active">Mes recettes</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="page-header">
            <div>
                <h1>Mes recettes</h1>
                <p class="page-subtitle">{{ recipes|length }} recette{{ recipes|length > 1 ? 's' }}{{ search ? ' trouvée' ~ (recipes|length > 1 ? 's') }}</p>
            </div>
            <a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Nouvelle recette
            </a>
        </div>

        <form method="get" action="{{ path('app_recipe_index') }}" class="d-flex flex-wrap gap-2 mb-3" role="search">
            <div class="search-bar flex-fill" style="max-width: 32rem; min-width: 14rem">
                <i class="fas fa-search"></i>
                <input type="search" name="q" value="{{ search }}" class="form-control"
                       placeholder="Rechercher une recette..." aria-label="Rechercher une recette">
            </div>
            <select name="order" class="form-select rounded-pill w-auto" aria-label="Trier les recettes" onchange="this.form.submit()">
                <option value="newest" {% if order == 'newest' %}selected{% endif %}>Plus récentes</option>
                <option value="oldest" {% if order == 'oldest' %}selected{% endif %}>Plus anciennes</option>
            </select>
            {% if search %}
                <a href="{{ path('app_recipe_index', {'order': order}) }}" class="btn btn-secondary rounded-pill" title="Effacer la recherche">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </form>

        <div class="card item-list">
            {% for recipe in recipes %}
                <div class="item-row">
                    <span class="item-avatar">{{ recipe.name|first }}</span>
                    <div class="item-main">
                        <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="item-title stretched-link">
                            {{ recipe.name }}
                        </a>
                        <div class="item-meta">
                            <span>
                                <i class="fas fa-fire-burner me-1"></i>
                                {% if recipe.numberOfTimes == 0 %}
                                    Jamais préparée
                                {% else %}
                                    {{ recipe.numberOfTimes }} fois{% if recipe.numberOfTimes >= 10 %} 🏆{% elseif recipe.numberOfTimes >= 5 %} 🌟{% endif %}
                                {% endif %}
                            </span>
                            {% if recipe.lastTimeDone %}
                                <span><i class="far fa-calendar me-1"></i>{{ recipe.lastTimeDone|date('d/m/Y') }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="item-actions">
                        <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}"
                           class="btn btn-action" title="Modifier la recette" aria-label="Modifier {{ recipe.name }}">
                            <i class="fas fa-pen"></i>
                        </a>
                        <form method="post"
                              action="{{ path('app_recipe_delete', {'id': recipe.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recipe.id) }}">
                            <button type="submit" class="btn btn-action btn-action-danger" title="Supprimer la recette" aria-label="Supprimer {{ recipe.name }}">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-book-open"></i></div>
                    {% if search %}
                        <p class="mb-0">Aucune recette ne correspond à « {{ search }} »</p>
                    {% else %}
                        <p>Aucune recette pour le moment</p>
                        <a href="{{ path('app_recipe_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Ajouter ma première recette
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
