{% extends 'base.html.twig' %}

{% block title %}Détails de la liste de courses{% endblock %}

{% block breadcrumb %}
    <nav style="--bs-breadcrumb-divider:'>';font-size:14px">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    <i class="fa-solid fa-house"></i>
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="{{ path('app_shopping_list_index') }}" class="text-decoration-none">
                    Mes listes de courses
                </a>
            </li>
            <li class="breadcrumb-item active">Détails de la liste</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <h1 class="h3 mb-0">
                                <i class="fas fa-clipboard-list me-2"></i>
                                {{ shopping_list.name ?? 'Liste de courses' }}
                            </h1>
                            <a href="{{ path('app_shopping_list_download_pdf', {'id': shopping_list.id}) }}"
                               class="btn btn-light btn-sm">
                                <i class="fas fa-file-pdf me-1"></i>
                                PDF
                            </a>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="table-responsive">
                                    <table class="table table-striped mb-0">
                                        <tbody>
                                            {% if shopping_list.name %}
                                            <tr>
                                                <th class="bg-light" style="width: 200px;">
                                                    <i class="fas fa-tag me-2"></i>
                                                    Nom de la liste
                                                </th>
                                                <td>{{ shopping_list.name }}</td>
                                            </tr>
                                            {% endif %}
                                            <tr>
                                                <th class="bg-light" style="width: 200px;">
                                                    <i class="fas fa-calendar-alt me-2"></i>
                                                    Date de création
                                                </th>
                                                <td>{{ shopping_list.createdAt ? shopping_list.createdAt|date('d/m/Y à H:i') : '' }}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 class="mb-3">
                                    <i class="fas fa-utensils me-2"></i>
                                    Recettes sélectionnées
                                </h4>
                                {% if shopping_list.recipes|length > 0 %}
                                    <div class="row row-cols-1 g-3 mb-4">
                                        {% for recipe in shopping_list.recipes %}
                                            <div class="col">
                                                <div class="card">
                                                    <div class="card-header bg-success text-white">
                                                        <h5 class="mb-0">
                                                            <i class="fas fa-utensils me-2"></i>
                                                            {{ recipe.name }}
                                                        </h5>
                                                    </div>
                                                    <div class="card-body">
                                                        {% if recipe.comment %}
                                                            <div class="alert alert-info mb-3">
                                                                <i class="fas fa-comment me-2"></i>
                                                                <strong>Commentaire :</strong> {{ recipe.comment }}
                                                            </div>
                                                        {% endif %}

                                                        {% if recipe.recipeIngredients|length > 0 %}
                                                            <h6 class="mb-2">
                                                                <i class="fas fa-list me-2"></i>
                                                                Ingrédients :
                                                            </h6>
                                                            <ul class="list-group">
                                                                {% for recipeIngredient in recipe.recipeIngredients %}
                                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                        <span>{{ recipeIngredient.ingredient.name }}</span>
                                                                        <span class="badge bg-primary rounded-pill">
                                                                            {{ recipeIngredient.quantity }} {{ recipeIngredient.ingredient.unit }}
                                                                        </span>
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% else %}
                                                            <p class="text-muted mb-0">
                                                                <i class="fas fa-exclamation-circle me-2"></i>
                                                                Aucun ingrédient pour cette recette
                                                            </p>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle me-2"></i>
                                        Aucune recette n'a été sélectionnée pour cette liste
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <h4 class="mb-3">
                                    <i class="fas fa-shopping-basket me-2"></i>
                                    Liste de courses complète
                                </h4>
                                {% set totalIngredients = shopping_list.totalIngredients %}
                                {% if totalIngredients|length > 0 or shopping_list.customItems|length > 0 %}
                                    <div class="table-responsive">
                                        <table class="table table-hover table-striped">
                                            <thead class="table-primary">
                                                <tr>
                                                    <th style="width: 50px;">
                                                        <i class="fas fa-shopping-cart"></i>
                                                    </th>
                                                    <th style="width: 60px;">Action</th>
                                                    <th>Ingrédient / Article</th>
                                                    <th style="width: 150px;">Quantité totale</th>
                                                    <th>Unité</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for item in totalIngredients %}
                                                    <tr class="ingredient-row {% if item.isHidden %}table-dark text-white text-decoration-line-through{% endif %}" data-ingredient-id="{{ item.ingredient.id }}">
                                                        <td>
                                                            <input type="checkbox"
                                                                   class="form-check-input cart-checkbox"
                                                                   data-ingredient-id="{{ item.ingredient.id }}"
                                                                   aria-label="Mettre {{ item.ingredient.name }} dans le caddie"
                                                                   {% if item.isHidden %}disabled{% endif %}
                                                                  {% if item.inCart %}checked{% endif %}>
                                                        </td>
                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm toggle-ingredient-btn {% if item.isHidden %}btn-success{% else %}btn-danger{% endif %}"
                                                                    data-ingredient-id="{{ item.ingredient.id }}"
                                                                    data-hidden="{{ item.isHidden ? 'true' : 'false' }}"
                                                                    title="{{ item.isHidden ? 'Remettre dans la liste' : 'Retirer de la liste' }}">
                                                                <i class="fas {% if item.isHidden %}fa-undo{% else %}fa-trash-alt{% endif %}"></i>
                                                            </button>
                                                        </td>
                                                        <td>
                                                            <strong class="ingredient-name {% if item.isHidden %}text-white{% endif %}">
                                                                {{ item.ingredient.name }}
                                                            </strong>
                                                        </td>
                                                        <td>
                                                            <input type="number"
                                                                   class="form-control form-control-sm quantity-input"
                                                                   step="0.01"
                                                                   value="{{ item.adjustedQuantity ?? item.quantity }}"
                                                                   data-ingredient-id="{{ item.ingredient.id }}"
                                                                   data-original-quantity="{{ item.quantity }}"
                                                                   aria-label="Quantité totale pour {{ item.ingredient.name }}"
                                                                   {% if item.isHidden %}disabled{% endif %}>
                                                        </td>
                                                        <td>{{ item.unit }}</td>
                                                    </tr>
                                                {% endfor %}
                                {% if shopping_list.customItems|length > 0 %}
                                    {% for customItem in shopping_list.customItems %}
                                        <tr class="table-info">
                                            <td>
                                                <input type="checkbox" class="form-check-input cart-checkbox"
                                                       data-custom-item-id="{{ customItem.id }}"
                                                       aria-label="Mettre {{ customItem.name }} dans le caddie"
                                                       {% if customItem.isInCart %}checked{% endif %}>
                                            </td>
                                            <td>
                                                <i class="fas fa-check-circle text-info"></i>
                                            </td>
                                            <td><strong>{{ customItem.name }}</strong> <span class="badge bg-info">Article libre</span></td>
                                            <td>{{ customItem.quantity ?? '-' }}</td>
                                            <td>-</td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% else %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Aucun ingrédient ni article trouvé.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light">
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_shopping_list_edit', {'id': shopping_list.id}) }}"
                               class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>
                                Modifier
                            </a>
                            <div class="row g-2">
                                <div class="col-6">
                                    <a href="{{ path('app_shopping_list_index') }}" class="btn btn-secondary w-100">
                                        <i class="fas fa-arrow-left me-1"></i>
                                        Retour
                                    </a>
                                </div>
                                <div class="col-6">
                                    <form method="post" action="{{ path('app_shopping_list_delete', {'id': shopping_list.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette liste de courses ?');" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shopping_list.id) }}">
                                        <button type="submit" class="btn btn-danger w-100">
                                            <i class="fas fa-trash-alt me-1"></i>
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const adjustUrl = '{{ path('app_shopping_list_adjust_ingredient', {'id': shopping_list.id}) }}';

        // Initialisation : appliquer la classe verte aux lignes déjà cochées (persistées)
        document.querySelectorAll('.cart-checkbox').forEach(cbInit => {
            const rowInit = cbInit.closest('tr');
            const nameCellInit = rowInit.querySelector('.ingredient-name') || rowInit.querySelector('strong');
            if (cbInit.checked) {
                rowInit.classList.add('table-success');
                rowInit.classList.remove('table-dark', 'table-info', 'table-secondary', 'text-muted');
                if (nameCellInit) {
                    nameCellInit.classList.remove('text-white', 'text-decoration-line-through');
                }
                rowInit.style.opacity = '1';
            } else {
                rowInit.classList.remove('table-success');
            }
        });

        // Gérer les checkboxes du caddie (visuel uniquement, pas de sauvegarde)
        document.querySelectorAll('.cart-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const row = this.closest('tr');
                const nameCell = row.querySelector('.ingredient-name') || row.querySelector('strong');
                const ingredientId = this.dataset.ingredientId;
                const customItemId = this.dataset.customItemId;
                const inCart = this.checked;

                if (this.checked) {
                    // Article mis dans le caddie - mettre la ligne en vert
                    row.classList.add('table-success');
                    row.classList.remove('table-dark', 'table-info', 'table-secondary', 'text-muted');
                    // S'assurer que le texte est lisible
                    nameCell.classList.remove('text-white', 'text-decoration-line-through');
                    row.style.opacity = '1';
                } else {
                    // Article retiré du caddie - revenir à l'état normal (ou sombre si masqué)
                    row.classList.remove('table-success');
                    // Ne pas forcer l'état barré ici : il est géré par le bouton de masquage
                    nameCell.classList.remove('text-decoration-line-through');
                    row.style.opacity = '1';
                }

                // Envoyer l'état inCart au serveur pour persistance
                const payload = { inCart: inCart };
                if (customItemId) {
                    payload.customItemId = customItemId;
                } else {
                    payload.ingredientId = ingredientId;
                }

                fetch(adjustUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(payload)
                }).then(resp => resp.json()).then(data => {
                    if (!data.success) console.error('Erreur sauvegarde inCart', data.error);
                }).catch(err => console.error('Erreur réseau:', err));
            });
        });

        // Gérer les boutons de masquage/affichage
        document.querySelectorAll('.toggle-ingredient-btn').forEach(button => {
            button.addEventListener('click', function() {
                const ingredientId = this.dataset.ingredientId;
                const isCurrentlyHidden = this.dataset.hidden === 'true';
                const newHiddenState = !isCurrentlyHidden;
                const row = this.closest('tr');
                const quantityInput = row.querySelector('.quantity-input');
                const nameCell = row.querySelector('.ingredient-name');
                const cartCheckbox = row.querySelector('.cart-checkbox');
                const icon = this.querySelector('i');

                // Mettre à jour l'apparence
                if (newHiddenState) {
                    // Masquer l'ingrédient - Fond noir, texte blanc barré
                    row.classList.remove('table-success'); // Retirer le vert si c'était dans le caddie
                    row.classList.add('table-dark', 'text-white', 'text-decoration-line-through');
                    row.classList.remove('table-secondary', 'text-muted', 'table-info');
                    nameCell.classList.add('text-white');
                    quantityInput.disabled = true;
                    if (cartCheckbox) {
                        cartCheckbox.disabled = true;
                        cartCheckbox.checked = false;
                    }
                    this.classList.remove('btn-danger');
                    this.classList.add('btn-success');
                    icon.classList.remove('fa-trash-alt');
                    icon.classList.add('fa-undo');
                    this.title = 'Remettre dans la liste';
                } else {
                    // Réafficher l'ingrédient
                    row.classList.remove('table-dark', 'text-white', 'text-decoration-line-through');
                    nameCell.classList.remove('text-white');
                    quantityInput.disabled = false;
                    if (cartCheckbox) {
                        cartCheckbox.disabled = false;
                    }
                    this.classList.remove('btn-success');
                    this.classList.add('btn-danger');
                    icon.classList.remove('fa-undo');
                    icon.classList.add('fa-trash-alt');
                    this.title = 'Retirer de la liste';
                }

                this.dataset.hidden = newHiddenState;

                // Envoyer la modification au serveur
                updateIngredient(ingredientId, { isHidden: newHiddenState });
            });
        });

        // Gérer les modifications de quantité
        let debounceTimer;
        document.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const ingredientId = this.dataset.ingredientId;
                const newQuantity = parseFloat(this.value);

                debounceTimer = setTimeout(() => {
                    if (!isNaN(newQuantity) && newQuantity > 0) {
                        updateIngredient(ingredientId, { quantity: newQuantity });
                    }
                }, 500); // Attendre 500ms après la dernière saisie
            });
        });

        function updateIngredient(ingredientId, data) {
            fetch(adjustUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    ingredientId: ingredientId,
                    ...data
                })
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    console.error('Erreur mise à jour ingrédient', data.error);
                }
            })
            .catch(err => console.error('Erreur réseau:', err));
        }
    });
    </script>
{% endblock %}
