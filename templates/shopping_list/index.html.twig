{% extends 'base.html.twig' %}

{% block title %}Mes listes de courses{% endblock %}

{% block breadcrumb %}
    <nav style="--bs-breadcrumb-divider:'>';font-size:14px">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    <i class="fa-solid fa-house"></i>
                </a>
            </li>
            <li class="breadcrumb-item active">Mes listes de courses</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
    <div class="container-fluid py-4">
        <div class="page-header">
            <div>
                <h1>Mes listes de courses</h1>
                <p class="page-subtitle">{{ shopping_lists|length }} liste{{ shopping_lists|length > 1 ? 's' }}</p>
            </div>
            <a href="{{ path('app_shopping_list_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Nouvelle liste
            </a>
        </div>

        <div class="card item-list">
            {% for shopping_list in shopping_lists %}
                <div class="item-row">
                    <span class="item-avatar avatar-tomato"><i class="fas fa-list-check"></i></span>
                    <div class="item-main">
                        <a href="{{ path('app_shopping_list_show', {'id': shopping_list.id}) }}" class="item-title stretched-link">
                            {{ shopping_list.name ?: 'Liste sans nom' }}
                        </a>
                        <div class="item-meta">
                            {% if shopping_list.createdAt %}
                                <span><i class="far fa-calendar me-1"></i>{{ shopping_list.createdAt|date('d/m/Y') }}</span>
                            {% endif %}
                            <span>{{ shopping_list.recipes|length }} recette{{ shopping_list.recipes|length > 1 ? 's' }}</span>
                        </div>
                    </div>
                    <div class="item-actions">
                        <a href="{{ path('app_shopping_list_download_pdf', {'id': shopping_list.id}) }}"
                           class="btn btn-action" title="Télécharger en PDF" aria-label="PDF de {{ shopping_list.name ?: 'la liste' }}">
                            <i class="fas fa-file-pdf"></i>
                        </a>
                        <a href="{{ path('app_shopping_list_edit', {'id': shopping_list.id}) }}"
                           class="btn btn-action d-none d-sm-inline-flex" title="Modifier la liste" aria-label="Modifier {{ shopping_list.name ?: 'la liste' }}">
                            <i class="fas fa-pen"></i>
                        </a>
                        <form method="post"
                              action="{{ path('app_shopping_list_delete', {'id': shopping_list.id}) }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette liste de courses ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shopping_list.id) }}">
                            <button type="submit" class="btn btn-action btn-action-danger" title="Supprimer la liste" aria-label="Supprimer {{ shopping_list.name ?: 'la liste' }}">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon"><i class="fas fa-basket-shopping"></i></div>
                    <p>Aucune liste de courses pour le moment</p>
                    <a href="{{ path('app_shopping_list_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Créer ma première liste
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
